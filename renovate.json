{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>claytono/renovate-config"],
  "ignoreDeps": ["claytono/github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tailscale-ssh/action\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=tailscale/tailscale\\n\\s+default: (?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tailscale/tailscale"
    }
  ]
}
